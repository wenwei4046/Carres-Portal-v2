# Web env vars — copy to .env.local (gitignored) and fill in real values.
# Vite only exposes vars prefixed with VITE_ to the browser bundle.

# Supabase (public-by-design, OK to expose)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Hono API base URL
# - local dev: 127.0.0.1 (wrangler dev binds here on Windows; localhost may not resolve)
# - prod: https://api.your-domain.com (set after Phase 9 Cloudflare deploy)
VITE_API_BASE_URL=http://127.0.0.1:8787
