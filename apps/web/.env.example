# Web env vars — copy to .env.local (gitignored) and fill in real values.
# Vite only exposes vars prefixed with VITE_ to the browser bundle.

# Supabase (public-by-design, OK to expose)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Hono API base URL
# - local dev: 127.0.0.1 (wrangler dev binds here on Windows; localhost may not resolve)
#   Port MUST match apps/api package.json `dev` script (`wrangler dev --port 8888`).
#   If you run another wrangler project alongside carres, give each project a
#   unique port to avoid hitting the wrong API and seeing mysterious 404s.
# - prod: https://api.your-domain.com (set after Phase 9 Cloudflare deploy)
VITE_API_BASE_URL=http://127.0.0.1:8888

# A DEV build REFUSES TO START if this points anywhere but this machine —
# 2026-08-10, 18 of 19 worktrees on one box were pointed at the production
# Worker, so every local save was writing to the live business. The guard is
# in src/lib/api-base.ts. To work against a remote API on purpose:
#   VITE_ALLOW_REMOTE_API=1 pnpm --filter @carres/web dev
