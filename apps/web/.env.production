# Production web env — COMMITTED ON PURPOSE (negated in repo-root .gitignore).
#
# These are PUBLIC, browser-safe values: Vite inlines VITE_* into the browser
# bundle at build time, the Supabase anon key is designed to ship to the browser
# (RLS is the security boundary), and the API base is a public URL. The secret
# service_role key is NEVER here — it lives only in Cloudflare Workers secrets.
#
# WHY committed: `pnpm build` reads .env files at build time. .env.local is
# gitignored, so a build on any clone/CI/session WITHOUT it would ship an
# env-less bundle → "Supabase not configured" prod login outage (happened
# 2026-06-04 and 2026-06-10). Committing prod values makes every production
# build self-contained. For local dev, .env.local (if present) overrides this.

# Supabase (Auth only — login goes browser → Supabase directly, per CLAUDE.md §4.2)
VITE_SUPABASE_URL=https://kfprgpjpaffedghytstl.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtmcHJncGpwYWZmZWRnaHl0c3RsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzc2OTYyNjUsImV4cCI6MjA5MzI3MjI2NX0.Ho64XP45Gz3X8YB5R27df9XISZl9UpORqYRDZ9BEdmI

# Hono API — production Worker URL
VITE_API_BASE_URL=https://carres-portal-v2-api.wwch.workers.dev
