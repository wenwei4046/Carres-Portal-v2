  "source": {
    "database": "production Supabase, READ-ONLY SELECT, run 2026-10-06; every row is TEST data (CLAUDE.md:557-560 clean-start law)",
    "orders": "with picked as (select o.*, row_number() over (partition by o.status order by o.placed_at desc) rn from orders o), sel as (select * from picked where (status='proceed_order' and rn<=12) or (status='place' and rn<=4) or (status in ('cancelled','delivered') and rn<=2)), sp as (select salesperson_id, 'Salesperson '||chr(64+dense_rank() over (order by salesperson_id)::int) alias from (select distinct salesperson_id from sel where salesperson_id is not null) x), numbered as (select s.*, row_number() over (order by s.placed_at desc) cust_n from sel s) select so, status, channel, placed_at::date, proceeded_at::date, proceed_date, delivery_date, customer_address_state, delivery_floor, delivery_has_lift, coalesce(outlets.name, dealers.name), sp.alias, do_number, paid, sum(order_lines.qty*unit_price), order_lines(sku, product_models.name||' '||product_skus.variant, qty), purchase_orders.id where so=po.so or so=any(po.so_refs) from numbered ... order by placed_at desc",
    "pos": "select p.id, p.status, p.sup_status, suppliers.name, purchasing_destinations.name, p.placed_at::date, p.official_delivery_date, p.version, p.purpose, p.is_consignment, so_refs+so, purchase_order_lines(sku, item, qty, received_qty, damaged_qty, wrong_item_qty), po_sends(channel, kind, sent_at::date, po_version), po_receipts(do_number, received_qty, received_at::date) from purchase_orders p where p.id in ('PO-20260902-8370','PO-20260903-4316','PO-20260903-7907','PO-20260903-4354','PO-20260903-1430','PO-20260903-5641','PO-20260907-1874') or p.status='received'  -- PO-SMOKE-C dropped to keep 10",
    "staff": "select u.id, u.role, u.status, u.title, u.is_person, u.operations_superuser, workspace_duty_assignments(duty_key, effective_from, effective_until) where effective_from <= '2026-10-31' and (effective_until is null or effective_until >= '2026-10-01') from app_users u where u.role='operation' order by u.created_at  -- all 6 operation users",
    "status_shown": "stored order status translated by docs/COPY-STANDARD.md:3755-3758 (place=Placed, proceed_order=Proceed, delivered=Delivered, cancelled=Cancelled)",
    "duty_label": "duty_key translated by packages/shared/src/workspace-duties-catalogue.ts:11-12",
    "field_mapping": "proceed_date = orders.proceeded_at (hand-off, docs/COPY-STANDARD.md:1328); planned_production_start = orders.proceed_date (docs/COPY-STANDARD.md:2518); requested_delivery_date = orders.delivery_date; po_delivery_date = purchase_orders.official_delivery_date",
    "anonymised": "customer name, phone, delivery address replaced; salesperson and staff names replaced; state, Sales Location, SO/PO/DO numbers, statuses, dates, items, quantities, suppliers kept"
  },
