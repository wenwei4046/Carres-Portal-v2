# =============================================================================
# Carres Portal v2 — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Dependencies
# -----------------------------------------------------------------------------
node_modules/
.pnpm-store/
.yarn/
.npm/

# -----------------------------------------------------------------------------
# Build outputs
# -----------------------------------------------------------------------------
dist/
build/
out/
.turbo/
.next/
.svelte-kit/
.dry-build/
*.tsbuildinfo

# -----------------------------------------------------------------------------
# Environment & secrets — NEVER commit these
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
# EXCEPTION: apps/web/.env.production holds ONLY public, browser-safe values
# (VITE_SUPABASE_URL + anon key + VITE_API_BASE_URL — all public-by-design; the
# anon key is meant for the browser and RLS is the security boundary; the
# service_role key is NEVER here, it lives only in Workers secrets). Committing
# it makes every production build self-contained, so a `pnpm build` on a clone
# WITHOUT .env.local can't ship an env-less bundle — that recurring footgun
# (2026-06-04 + 2026-06-10) shipped a "Supabase not configured" prod login
# outage. Vite still loads .env.local OVER this for local dev.
!apps/web/.env.production

# Cloudflare Workers local secrets (read by `wrangler dev`)
.dev.vars

# Understand Anything
.ua/

# -----------------------------------------------------------------------------
# Cloudflare
# -----------------------------------------------------------------------------
.wrangler/
.cloudflare/
wrangler.toml.bak

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
supabase/.branches/
supabase/.temp/
supabase/seed_data_local/

# -----------------------------------------------------------------------------
# Design reference (zip extracted here for Claude Code to read)
# Excluded from git, build, and deploy.
# -----------------------------------------------------------------------------
reference/

# -----------------------------------------------------------------------------
# IDE & editor
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# -----------------------------------------------------------------------------
# OS
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -----------------------------------------------------------------------------
# Test artifacts
# -----------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov
playwright-report/
playwright/.cache/
test-results/
.playwright-mcp/
phase-*-success-*.png
phase-*-dealer-*.png
phase-*-detail-*.png
qa-*.png

# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.vite/

# -----------------------------------------------------------------------------
# AI tooling artifacts (local sessions + GitNexus index/generated files + gstack)
# -----------------------------------------------------------------------------
.claude/
.gitnexus/
.gstack/
AGENTS.md

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
*.tgz
*.tar.gz
*.zip
.tmp/
tmp/

# -----------------------------------------------------------------------------
# Local-only working state (retro snapshots, drafts that don't belong in git)
# -----------------------------------------------------------------------------
.context/

# editor/tool backup files
*.bak

# Real Carres master data (12 live contact emails, 0 placeholders left).
# The .template beside it stays tracked; the filled copy never returns to git.
scripts/production-master-data.sql
