# Carres Portal v2 — environment variables overview (documentation only)
#
# Vite and Wrangler each read from their own per-app files. This top-level file
# is a reference list of every env var the project uses across both apps.
#
#   apps/web/.env.example   → copy to apps/web/.env.local   (Vite reads this)
#   apps/api/.dev.vars.example → copy to apps/api/.dev.vars (Wrangler reads this)
#
# Both .env.local and .dev.vars are gitignored. Real values never enter git.

# === Web (Vite) — exposed to browser bundle ===
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_BASE_URL=http://localhost:8787

# === API (Wrangler) — Hono server-side only, never browser ===
# Local dev: lives in apps/api/.dev.vars
# Production deploy (Phase 9): use `wrangler secret put <KEY>`
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
